#=============================================================================
# Bible Teacher - Installation Configuration File
#=============================================================================
# Copy this file to install.config and customize the values below.
# Usage: sudo bash install.sh
#
# The install script will automatically load this file if it exists.
#=============================================================================

#-----------------------------------------------------------------------------
# Application Settings
#-----------------------------------------------------------------------------
APP_NAME="bibleteacher"
APP_DIR="/var/www/bibleteacher"
APP_USER="www-data"
APP_GROUP="www-data"

#-----------------------------------------------------------------------------
# Database Settings
#-----------------------------------------------------------------------------
DB_NAME="bibleteacher"
DB_USER="bibleuser"
# IMPORTANT: Set a strong database password
DB_PASSWORD=""  # Will be prompted if left empty

#-----------------------------------------------------------------------------
# Server Settings
#-----------------------------------------------------------------------------
# Your domain name (leave empty to use IP address only)
DOMAIN="bible.tasteandseegardens.com"

# Server IP (auto-detected if left empty)
SERVER_IP="172.237.145.177"

# Number of Gunicorn worker processes (recommended: 2-4 x CPU cores)
GUNICORN_WORKERS=3

#-----------------------------------------------------------------------------
# SSL/TLS Settings
#-----------------------------------------------------------------------------
# Set up SSL with Let's Encrypt? (y/n) 
SETUP_SSL="y"

# Admin email for Let's Encrypt notifications (required if SETUP_SSL=y)
ADMIN_EMAIL="bill@tasteandseegardens.com"

#-----------------------------------------------------------------------------
# Advanced Settings (optional)
#-----------------------------------------------------------------------------
# Gunicorn socket location
GUNICORN_SOCK="/run/gunicorn.sock"

# Python virtual environment directory
# VENV_DIR="${APP_DIR}/venv"

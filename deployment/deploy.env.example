#=============================================================================
# Bible Teacher - Deploy Script Configuration
#=============================================================================
# Copy this file to deploy.env and fill in your server details.
# This file is used by deployment/deploy.sh for manual deployments.
#=============================================================================

# Your Akamai (Linode) server IP address or domain
DEPLOY_HOST="your.server.ip.address"

# SSH user that can access the server and run commands as APP_USER
# This user should have passwordless sudo or be configured appropriately
DEPLOY_USER="deploy"

# Application directory on the remote server
APP_DIR="/var/www/bibleteacher"

# OS user that owns the application files and virtual environment
APP_USER="www-data"
